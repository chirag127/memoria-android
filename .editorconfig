root = true

[*.{kt,kts}]
indent_size = 4
indent_style = space
max_line_length = 140
insert_final_newline = true
trim_trailing_whitespace = true

# Allow @Inject on same line as constructor
ktlint_standard_annotation = disabled
# Allow single-expression functions on same line as = 
ktlint_standard_multiline-expression-wrapping = disabled
# Allow function params on single line when they fit
ktlint_standard_function-signature = disabled
